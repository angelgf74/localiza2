<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ── TextAppearances segun Material 3 Design System ───────────────── -->

    <!-- Display (muy grande, headings principales) -->
    <style name="TextAppearance.Localiza2.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Headline (headings secundarios) -->
    <style name="TextAppearance.Localiza2.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Title (headings pequeños, nombres de contactos) -->
    <style name="TextAppearance.Localiza2.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <!-- Body (texto regular) -->
    <style name="TextAppearance.Localiza2.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- Label (etiquetas, botones, hints) -->
    <style name="TextAppearance.Localiza2.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.Localiza2.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_muted</item>
    </style>
    <style name="TextAppearance.Localiza2.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textColor">@color/text_muted</item>
    </style>

    <!-- ── Button Styles ──────────────────────────────────────────────────── -->

    <!-- Primary Button -->
    <style name="Widget.Localiza2.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="backgroundTint">@color/accent_primary</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Outline Button -->
    <style name="Widget.Localiza2.Button.Outline" parent="Widget.MaterialComponents.OutlinedButton">
        <item name="android:textColor">@color/text_muted</item>
        <item name="strokeColor">@color/bg_surface_3</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Text Button (no background) -->
    <style name="Widget.Localiza2.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent_primary</item>
    </style>

    <!-- ── Card View ──────────────────────────────────────────────────────── -->

    <style name="Widget.Localiza2.CardView" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="cardCornerRadius">10dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/bg_surface_3</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- ── Text Input ──────────────────────────────────────────────────────── -->

    <style name="Widget.Localiza2.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/bg_primary</item>
        <item name="boxStrokeColor">@color/bg_surface_3</item>
        <item name="boxCornerRadiusBottomEnd">6dp</item>
        <item name="boxCornerRadiusBottomStart">6dp</item>
        <item name="boxCornerRadiusTopEnd">6dp</item>
        <item name="boxCornerRadiusTopStart">6dp</item>
        <item name="hintTextColor">@color/text_muted</item>
    </style>

</resources>
